<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:input="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:local="clr-namespace:DataGridBulkEditSample"
             x:Class="DataGridBulkEditSample.MainPage"
             Title="Home">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="syncfusion:DataGridHeaderCell">
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Background" Value="#512BD4"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Selection mode picker -->
        <HorizontalStackLayout Spacing="12" VerticalOptions="Start" Margin="8,0,0,8">
            <input:SfTextInputLayout WidthRequest="200" Hint="Mode">
                <Picker HeightRequest="40" SelectedItem="{Binding SelectedSelectionMode, Mode=TwoWay}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Cell</x:String>
                            <x:String>Row</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </input:SfTextInputLayout>
        </HorizontalStackLayout>

        <syncfusion:SfDataGrid x:Name="dataGrid"
                               Grid.Row="1"
                               AllowEditing="True"
                               SelectionMode="Multiple"
                               ColumnWidthMode="Fill"
                               GridLinesVisibility="Both"
                               ItemsSource="{Binding Orders}">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridNumericColumn MappingName="EmployeeID" HeaderText="ID" CellTextAlignment="Center" HeaderTextAlignment="Center" Format="N0" AllowEditing="False"/>
                <syncfusion:DataGridTextColumn MappingName="CustomerName" HeaderText="Name" CellTextAlignment="Center" HeaderTextAlignment="Center"/>
                <syncfusion:DataGridDateColumn MappingName="Date" HeaderText="Date" CellTextAlignment="Center" HeaderTextAlignment="Center"/>
                <syncfusion:DataGridTextColumn MappingName="Country" HeaderText="Country" CellTextAlignment="Center" HeaderTextAlignment="Center"/>
                <syncfusion:DataGridTextColumn MappingName="Status" HeaderText="Status" CellTextAlignment="Center" HeaderTextAlignment="Center"/>
                <syncfusion:DataGridTextColumn MappingName="Branch" HeaderText="Branch" CellTextAlignment="Center" HeaderTextAlignment="Center"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <popup:SfPopup  x:Name="bulkEditPopup"
                        Grid.Row="1"
                        WidthRequest="500"
                        HeightRequest="560"
                        ShowHeader="True"
                        ShowFooter="True"
                        HeaderTitle="{Binding TargetMappingName}"
                        AppearanceMode="TwoButton"
                        AcceptButtonText="Apply"
                        DeclineButtonText="Cancel"
                        IsOpen="{Binding IsBulkPopupOpen, Mode=TwoWay}"
                        AcceptCommand="{Binding ApplyBulkEditCommand}"
                        DeclineCommand="{Binding CancelBulkEditCommand}">

            <popup:SfPopup.ContentTemplate>
                <DataTemplate>
                    <ScrollView>
                        <VerticalStackLayout Padding="16,16,16,32" Spacing="16">

                            <!-- Cell selection UI: editor type is picked from the discriminator -->
                            <VerticalStackLayout IsVisible="{Binding IsCellSelectionMode}" Spacing="16">

                                <!-- Status editor (shown only when TargetMappingName == "Status") -->
                                <input:SfTextInputLayout IsVisible="{Binding IsStatusEditing}" Hint="Select Status">
                                    <Picker ItemsSource="{Binding StatusOptions}"
                                            SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                                </input:SfTextInputLayout>

                                <!-- Date editor (shown only when TargetMappingName == "Date") -->
                                <input:SfTextInputLayout IsVisible="{Binding IsDateEditing}" Hint="Select Date">
                                    <DatePicker Date="{Binding BulkEditDate, Mode=TwoWay}"/>
                                </input:SfTextInputLayout>

                                <!-- Text editor for any other writable text column -->
                                <input:SfTextInputLayout IsVisible="{Binding IsTextEditing}" Hint="Enter New value">
                                    <Entry Text="{Binding BulkEditValue, Mode=TwoWay}"/>
                                </input:SfTextInputLayout>

                            </VerticalStackLayout>

                            <!-- Row selection UI: show an editor for EVERY editable column
                                 at once. Apply updates only fields whose value the user has
                                 actually changed (left a non-empty value). -->
                            <VerticalStackLayout IsVisible="{Binding IsCellSelectionMode, Converter={StaticResource InverseBooleanConverter}}" Spacing="12">

                                <Label Text="Edit Your Values" FontAttributes="Bold"/>
                                <Label Text="Fill only the fields you want to update. Empty fields are ignored."
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                                <!-- EmployeeID is intentionally absent: declared AllowEditing="False" on the grid. -->

                                <!-- CustomerName -->
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowSpacing="6">
                                    <Label Grid.Column="0" Text="Customer Name" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1"
                                           Placeholder="New Customer Name"
                                           Text="{Binding RowEditCustomerName, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Country -->
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowSpacing="6">
                                    <Label Grid.Column="0" Text="Country" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1"
                                           Placeholder="New Country"
                                           Text="{Binding RowEditCountry, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Status -->
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowSpacing="6">
                                    <Label Grid.Column="0" Text="Status" VerticalOptions="Center"/>
                                    <Picker Grid.Column="1"
                                            Title="Select Status"
                                            ItemsSource="{Binding StatusOptions}"
                                            SelectedItem="{Binding RowEditStatus, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Date -->
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowSpacing="6">
                                    <Label Grid.Column="0" Text="Date" VerticalOptions="Center"/>
                                    <DatePicker Grid.Column="1"
                                                Date="{Binding RowEditDate, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Branch -->
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12" RowSpacing="6">
                                    <Label Grid.Column="0" Text="Branch" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1"
                                           Placeholder="New Branch"
                                           Text="{Binding RowEditBranch, Mode=TwoWay}"/>
                                </Grid>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>
    </Grid>
</ContentPage>